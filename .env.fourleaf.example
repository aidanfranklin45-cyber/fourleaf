# FourLeaf Real Estate Configuration Example
# Copy to .env.fourleaf and fill in your values

MRE_VERSION=latest

# MongoDB Atlas Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/fourleaf?retryWrites=true&w=majority&appName=Cluster0

# Host-side ports for the reverse proxy (Caddy)
MRE_HTTP_PORT=80
MRE_HTTPS_PORT=443

# Reverse proxy trust setting
TRUST_PROXY=uniquelocal

# Application Secrets (generate via openssl rand -base64 24)
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
RESET_TOKEN_SECRET=your_reset_token_secret
CIPHER_KEY=your_cipher_key_32_chars
CIPHER_IV_KEY=your_cipher_iv_key_16_chars
REDIS_PASSWORD=your_redis_password
